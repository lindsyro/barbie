generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  salt         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions  Session[]
  cartItems CartItem[]
  wishlist  WishlistItem[]
  orders    Order[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("sessions")
}

model CartItem {
  id        String   @id @default(uuid())
  contextId String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  patternId Int
  pattern   Pattern  @relation(fields: [patternId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@unique([contextId, patternId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(uuid())
  contextId String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  patternId Int
  pattern   Pattern  @relation(fields: [patternId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@unique([contextId, patternId])
  @@map("wishlist_items")
}

model Order {
  id            String   @id
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail     String
  userName      String
  status        String   @default("paid")
  paymentMethod String   @default("card")
  totalAmount   Int
  currency      String   @default("RUB")
  createdAt     DateTime @default(now())

  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  patternId   Int
  pattern     Pattern @relation(fields: [patternId], references: [id], onDelete: Restrict)
  title       String
  doll        String
  price       Int
  format      String
  downloadUrl String

  @@unique([orderId, patternId])
  @@map("order_items")
}

model Review {
  id           Int      @id @default(autoincrement())
  author       String
  doll         String
  patternTitle String
  rating       Int      @default(5)
  text         String
  createdAt    DateTime @default(now())

  @@map("reviews")
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  promoCode String   @default("GOOSE10")
  createdAt DateTime @default(now())

  @@map("subscribers")
}

model DollCategory {
  id    Int    @id @default(autoincrement())
  slug  String @unique
  name  String
  order Int    @default(0)

  dolls Doll[]

  @@map("doll_categories")
}

model Doll {
  id                   Int     @id @default(autoincrement())
  fileName             String
  nameEn               String
  nameRu               String
  height               Float
  measurementsFileName String?

  categoryId Int
  category   DollCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  patterns   Pattern[]    @relation("DollPatterns")

  @@map("dolls")
}

model Pattern {
  id    Int    @id @default(autoincrement())
  title String
  price Int

  dolls         Doll[]         @relation("DollPatterns")
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("patterns")
}

model MenuItem {
  id        Int      @id @default(autoincrement())
  title     String
  url       String
  order     Int      @default(0)
  target    String   @default("_self")
  isVisible Boolean  @default(true)
  isDynamic Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("menu_items")
}
